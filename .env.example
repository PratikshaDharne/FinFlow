# ---------------------------------------------------------------------------
# FinFlow configuration template.
#   1. Copy to ".env"  (PowerShell:  Copy-Item .env.example .env)
#   2. Fill in values.  NEVER commit .env - it is git-ignored.
#   3. In Azure, prefer Managed Identity + Key Vault (see docs/security_and_governance.md)
# ---------------------------------------------------------------------------

FINFLOW_ENV=dev                      # dev | test | prod

# --- Target database -------------------------------------------------------
# sqlite = zero-setup local/CI mode.  mysql = the real target (MySQL 8.0).
FINFLOW_DB_BACKEND=sqlite
FINFLOW_SQLITE_PATH=data/local/finflow.db

# Used when FINFLOW_DB_BACKEND=mysql
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=finflow
MYSQL_USER=finflow_etl
MYSQL_PASSWORD=                      # set locally, or load from Key Vault (secret name: MYSQL-PASSWORD)

# --- Pipeline behaviour ----------------------------------------------------
FINFLOW_AUTO_INIT_SCHEMA=true        # set false in prod (ETL user should not hold DDL rights)
FINFLOW_DQ_MAX_REJECT_PCT=20         # abort the load if more than this % of a file is rejected
FINFLOW_INCREMENTAL_LOOKBACK_HOURS=24
FINFLOW_STAGING_RETENTION_LOADS=5
FINFLOW_MASK_PII_IN_REPORTS=true
FINFLOW_LOG_LEVEL=INFO
FINFLOW_DB_RETRY_ATTEMPTS=3

# --- Azure (optional, UNTESTED here) ----------------------------------------
FINFLOW_AZURE_ENABLED=false
AZURE_STORAGE_ACCOUNT_URL=https://<storageaccount>.blob.core.windows.net
AZURE_STORAGE_RAW_CONTAINER=raw
# Local dev only. Prefer Managed Identity / `az login` (DefaultAzureCredential) over keys.
AZURE_STORAGE_CONNECTION_STRING=
# If set, secrets missing from the environment are read from Key Vault.
KEY_VAULT_URL=

# --- Snowflake (optional, UNTESTED here) -----------------------------------
FINFLOW_SNOWFLAKE_ENABLED=false
SNOWFLAKE_ACCOUNT=<orgname>-<accountname>
SNOWFLAKE_USER=FINFLOW_ETL_SVC
SNOWFLAKE_ROLE=FINFLOW_ETL_ROLE
SNOWFLAKE_WAREHOUSE=FINFLOW_WH
SNOWFLAKE_DATABASE=FINFLOW_DB
SNOWFLAKE_PASSWORD=                  # or use key-pair auth: SNOWFLAKE_PRIVATE_KEY_PATH
SNOWFLAKE_PRIVATE_KEY_PATH=

# --- docker-compose (local MySQL 8.0 only) ----------------------------------
MYSQL_ROOT_PASSWORD=
