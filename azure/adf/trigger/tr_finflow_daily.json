{
  "name": "tr_finflow_daily",
  "properties": {
    "type": "TumblingWindowTrigger",
    "description": "Daily window (UTC). Retries a failed window twice, 5 minutes apart; max one window at a time so loads never overlap.",
    "pipeline": {
      "pipelineReference": { "referenceName": "pl_finflow_daily", "type": "PipelineReference" },
      "parameters": { "batchDate": "@formatDateTime(trigger().outputs.windowStartTime, 'yyyy-MM-dd')" }
    },
    "typeProperties": {
      "frequency": "Hour",
      "interval": 24,
      "startTime": "2026-01-01T02:00:00Z",
      "delay": "00:15:00",
      "maxConcurrency": 1,
      "retryPolicy": { "count": 2, "intervalInSeconds": 300 }
    }
  }
}
